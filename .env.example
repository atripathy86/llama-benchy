# OpenAI-compatible server root. llama-benchy adds /v1 when it reads API_BASE
# from this file.
API_BASE=https://localhost
# Leave empty for an endpoint that does not require authentication.
API_KEY=

# Optional comma-separated model subset for the multi-model runner. Leave empty
# to select with --models, --all, or the interactive prompt.
LLAMA_BENCHY_MODELS=
# Optional comma-separated benchmark profiles. If omitted, select a profile with
# --profile or interactively. Allowed: smoke, sweep, throughput, full, matrix.
LLAMA_BENCHY_PROFILE=